# =============================================================================
# .gitignore — Utils Collection
# =============================================================================
# Проект: stdlib-only Python утилиты
# Философия: игнорим всё сгенерированное, временное, системное.
# Закомментированное (#?) — кандидаты на игнор. Раскомментируй если нужно.
# =============================================================================


# ---------------------
# Python
# ---------------------

__pycache__/
*.py[cod]
# *.py[cod] покрывает .pyc, .pyo, .pyd

*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Виртуальные окружения
venv/
.venv/
env/
.env/
ENV/

# mypy / pyright / type checkers
.mypy_cache/
.pyright/
.pyre/

# pytest
.pytest_cache/

# coverage
htmlcov/
.coverage
.coverage.*
coverage.xml


# ---------------------
# Settings (generated by scripts)
# ---------------------

# Наши скрипты создают settings_*.json рядом с собой.
# Это пользовательские настройки — не коммитим.
settings_*.json

# Output файлы скриптов (результат работы, не исходники)
collected_code.md


# ---------------------
# OS
# ---------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory


# ---------------------
# Editors / IDEs
# ---------------------

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

#? Obsidian — vault config в корне проекта.
#? Раскомментируй если .obsidian не нужен в репо.
#? .obsidian/


# ---------------------
# Jupyter / IPython
# ---------------------

.ipynb_checkpoints/
profile_default/
ipython_config.py

#? *.ipynb — если хочешь игнорить сами ноутбуки (оставлять только .py)
#? *.ipynb


# ---------------------
# Логи и временные файлы
# ---------------------

*.log
*.tmp
*.temp
*.bak
*.orig


# ---------------------
# Секреты и credentials
# ---------------------

.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

#? secrets.json
#? credentials.json
#? token.json


# ---------------------
# Docker (на будущее)
# ---------------------

#? docker-compose.override.yml
#? .docker/


# ---------------------
# Node.js (на будущее, если появятся JS-утилиты)
# ---------------------

#? node_modules/
#? package-lock.json
#? yarn.lock
#? .npm/
#? .yarn/


# ---------------------
# Данные и тяжёлые файлы
# ---------------------

*.csv
*.tsv
*.sqlite
*.db
*.sqlite3

# Бинарники и архивы
*.zip
*.gz
*.tar
*.rar
*.7z
*.exe
*.dll

# Медиа (если случайно попадут)
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.tif
*.tiff
*.bmp
*.mp4
*.mp3

#? *.pdf


